#!/usr/bin/env bash
# Cascade hop guard — agent-agnostic. Runs under any coding agent, and for humans.
#   1. GENERATE hop may not stage product code (I4, I15)
#   2. <EDIT> tag contents are human-authored and may not change (I15)
# Bypass with --no-verify is possible; CI is the backstop.
set -euo pipefail
# Never silent (t74): a command failing where the hook did not expect it names itself instead of ending the hook
# with exit 1 and nothing on screen. It decides nothing — set -e still exits, exactly as before.
trap 'echo "cascade: pre-commit stopped at line $LINENO (exit $?) — a hook error, not a verdict; run  bash -x .githooks/pre-commit  to see it" >&2' ERR
ROOT="$(git rev-parse --show-toplevel)"
# Cleanup must never decide this hook's exit status. `rm -f` still returns non-zero when a parent path
# component is a file — which is what .git is inside a worktree — and under `set -e` that aborted commits
# whose every check had passed, reporting only "Not a directory" (T45, T47).
_scratch=""
cleanup() { local rc=$?; [[ -n "$_scratch" ]] && rm -rf $_scratch 2>/dev/null; return "$rc"; }
trap cleanup EXIT
scratch() { local f; f="$(mktemp)"; _scratch="$_scratch $f"; echo "$f"; }
# shellcheck source=tests/lib/cascade.sh
. "$ROOT/tests/lib/cascade.sh"

hop="$(cascade_hop)"
autopilot_accepted=0
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
# Deletions matter too (a law test removed in its own commit must not slip past): only exit when nothing at all is staged.
[[ -z "$(git diff --cached --name-only)" ]] && exit 0

fail=0

if [[ "$hop" == "GENERATE" ]]; then
  offenders=()
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if cascade_is_product_path "$path"; then
      offenders+=("$path")
    fi
  done <<< "$staged"
  if [[ ${#offenders[@]} -gt 0 ]]; then
    echo "BLOCKED: GENERATE stage $(cascade_stage) may not write product code (I4/I15)." >&2
    printf '  %s\n' "${offenders[@]}" >&2
    echo "  GENERATE produces spec + plan only. Get 'approved, execute' first." >&2
    fail=1
  fi
fi

# t68: a law may leave force — retired, or its block deleted — inside an open hop only if it is GREEN. Before the
# human key on purpose: dropping a failing law to turn a gate green is I18 whoever does it. The merge gate re-proves
# it from git (tests/retirements.sh), so --no-verify does not get around it either.
if [[ -f "$ROOT/tests/lib/retirement_guard.py" ]]; then
  python3 -B "$ROOT/tests/lib/retirement_guard.py" staged "$ROOT" || fail=1
elif [[ -n "$(git diff --cached --no-renames --name-only -- docs/cascade/envelope.md 'docs/cascade/laws/*.md' 2>/dev/null || true)" ]]; then
  echo "BLOCKED: tests/lib/retirement_guard.py is missing, so a change to the laws cannot be checked (t68) — re-run install.sh" >&2
  fail=1
fi

if [[ "${CASCADE_HUMAN:-}" == "1" ]]; then
  echo "cascade: CASCADE_HUMAN=1 — human stitch, human-ownership checks lifted for this commit." >&2
  exit "$fail"
fi

# A human's approval of an agent edit (the permission dialog) is recorded by .claude/hooks/sign_ok.py as
# "<sha256> <path>" in $GIT_DIR/cascade-human-ok. It signs exactly that content, once. The agent cannot
# write that file: bash_guard denies any command naming it.
GITDIR="$(git rev-parse --git-dir)"; [[ "$GITDIR" == /* ]] || GITDIR="$ROOT/$GITDIR"
TOKENS="$GITDIR/cascade-human-ok"
# A token is spent only by a commit that actually lands. Consuming it during validation burned the
# human's signature on any run that failed later for an unrelated reason, sending them back to sign again
# — a loop they hit in real use. Matches are recorded here and spent once, at the end, if fail=0 (T46).
_matched=""
human_ok() { # human_ok <path> -> 0 if the staged blob of <path> carries a human token (does NOT spend it)
  [[ -f "$TOKENS" ]] || return 1
  local sha
  sha="$(git show ":$1" 2>/dev/null | python3 -B -c 'import sys,hashlib; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')"
  grep -qF "$sha $1" "$TOKENS" || return 1
  case "$_matched" in
    *"|$sha $1|"*) ;;                       # the envelope is checked twice; spend its token once
    *) _matched="$_matched|$sha $1|" ;;
  esac
  echo "cascade: human signature accepted for $1" >&2
  return 0
}

# A law's test is the law (I13). Changing or deleting an existing tests/inv/* file is a hop-edge decision:
# the agent must STOP and ask; a human accepts it with the key. New law tests are welcome.
# One entry per line, `<path>\t<kind>\t<reason>`: a path is never word-split (a space in a name once split one new
# file into two and let half of it through), and the human_ok pass below reads the path back exactly.
# Existing files: changed, removed, or their type changed (a symlink swapped in for a law's test is a `T`, which no
# filter here used to see). --no-renames: a rename is the old path removed plus the new one added, so it meets both
# checks, and a copy is an addition.
inv_touched=""
while IFS= read -r f; do
  [[ -n "$f" ]] && inv_touched="${inv_touched}${f}"$'\t'"existing"$'\t'"(an existing law test, changed, removed or replaced)"$'\n'
done < <(git diff --cached --no-renames --name-only --diff-filter=MDT -z -- 'tests/inv/*' 2>/dev/null | tr '\0' '\n' || true)
# A new file under tests/inv/ (t74). Rule 5 lets an agent add a test or red twin for a NEW law, and nothing else:
#   - its name must carry the law's id (`test_D49.py`, `twin_D49.tsv`, `mutants/D49.patch`) — a file with no id,
#     such as a conftest.py, can change every law's verdict without touching a law's own test;
#   - every id in the name counts: one that a law declares makes the file that law's (`test_D99_D1.sh` is D1's too);
#   - an id no law declares is a new law: allowed;
#   - a declared id is allowed only on a path that law's own commands name, token for token (its expected work while
#     UNPROVEN); anything else under a declared law is the agent redefining that law's test surface.
# Ids are read with bash's own regex: no subprocess, nothing for set -e to trip on. A grep pipeline here once ended
# this hook with exit 1 and no message on any name without `test_D`.
id_re='(^|[^A-Za-z0-9])(D[0-9]+)(.*)$'
laws_out=""; laws_read=0; laws_unreadable=0
while IFS= read -r f; do
  [[ -n "$f" ]] || continue
  ids=(); rest="${f##*/}"
  while [[ "$rest" =~ $id_re ]]; do ids+=("${BASH_REMATCH[2]}"); rest="${BASH_REMATCH[3]}"; done
  if [[ ${#ids[@]} -eq 0 ]]; then
    inv_touched="${inv_touched}${f}"$'\t'"new"$'\t'"(no D# id in its name — a new law's test or twin is named after its id, e.g. tests/inv/mutants/D49.patch; anything else here is the human's)"$'\n'
    continue
  fi
  if [[ "$laws_read" -eq 0 ]]; then
    # Every declared law in either form, envelope and shards (t67). Laws that cannot be read (a duplicate id)
    # count every id as declared, so the file is blocked rather than waved through.
    laws_out="$(python3 -B "$ROOT/tests/lib/laws.py" "$ROOT/docs/cascade/envelope.md" --declared --shards "$ROOT/docs/cascade/laws" 2>/dev/null)" \
      || laws_unreadable=1
    laws_read=1
  fi
  why=""
  for id in "${ids[@]}"; do
    if [[ "$laws_unreadable" -eq 1 ]]; then law="${id}|(laws unreadable)"
    else law="$(grep -E "^${id}\|" <<<"$laws_out" | head -1 || true)"; fi
    [[ -n "$law" ]] || continue                       # an id no law declares: a new law's test
    named=0
    read -ra toks <<<"${law//|/ }"
    for tok in "${toks[@]}"; do                        # a whole token of the law's commands, not a substring of one
      tok="${tok//\"/}"; tok="${tok//\'/}"; tok="${tok%;}"; tok="${tok#./}"; tok="${tok%%::*}"
      if [[ "$tok" == "$f" ]]; then named=1; break; fi
    done
    if [[ "$named" -eq 0 ]]; then why="(reuses declared $id — a new file that law's commands do not name; only a human extends a law)"; break; fi
  done
  [[ -z "$why" ]] || inv_touched="${inv_touched}${f}"$'\t'"new"$'\t'"${why}"$'\n'
done < <(git diff --cached --no-renames --name-only --diff-filter=A -z -- 'tests/inv/*' 2>/dev/null | tr '\0' '\n' || true)
inv_existing=""; inv_new=""
while IFS=$'\t' read -r f kind why; do
  [[ -n "$f" ]] || continue
  human_ok "$f" && continue
  if [[ "$kind" == existing ]]; then inv_existing="${inv_existing}  ${f} ${why}"$'\n'
  else inv_new="${inv_new}  ${f} ${why}"$'\n'; fi
done <<< "$inv_touched"
if [[ -n "$inv_existing" ]]; then
  echo "BLOCKED: existing D# tests are human-owned (I13):" >&2
  printf '%s' "$inv_existing" >&2
fi
if [[ -n "$inv_new" ]]; then
  echo "BLOCKED: a new file under tests/inv/ that is not a new law's own test (I13, AGENTS.md rule 5):" >&2
  printf '%s' "$inv_new" >&2
fi
if [[ -n "$inv_existing$inv_new" ]]; then
  echo "  A new law's red twin goes in a NEW file named after its id (tests/inv/mutants/D49.patch); a change to an" >&2
  echo "  existing file there, a file with no id, or a new file under a declared law is the human's (AGENTS.md rule 5)." >&2
  echo "  If YOU made this edit: run  bash tests/sign.sh  and commit again. Otherwise send the hop back." >&2
  fail=1
fi

# t78: the regression suite (docs/cascade/regress.md) holds accepted slices' tests. Adding a line is free; removing or
# changing one is the human's: a line HEAD had must still be staged (multiset, whitespace collapsed) unless the staged
# blob carries the human's signature. Deleting or renaming the file away leaves no blob to sign: only the key.
# Any hop. The merge gate re-proves this from git (tests/regress.sh --gate), so --no-verify gains nothing there.
REG=docs/cascade/regress.md
reg_staged="$(git diff --cached --no-renames --name-only -- "$REG" 2>/dev/null || true)"   # no pipe into grep -q (T47)
if git cat-file -e "HEAD:$REG" 2>/dev/null && [[ "$reg_staged" == "$REG" ]]; then
  if git cat-file -e ":$REG" 2>/dev/null; then
    before="$(scratch)"; after="$(scratch)"
    git show "HEAD:$REG" > "$before" 2>/dev/null || : > "$before"
    git show ":$REG" > "$after" 2>/dev/null || : > "$after"
    if ! reg_missing="$(python3 -B "$ROOT/tests/lib/regress_lines.py" dropped "$before" "$after" 2>/dev/null)"; then
      if ! human_ok "$REG"; then
        echo "BLOCKED: $REG — a regression line removed or changed (t78):" >&2
        printf '%s\n' "$reg_missing" | sed 's/^/  /' >&2
        echo "  A regression line is an accepted slice's test; removing or changing it is the human's. Adding is free." >&2
        echo "  If YOU (the human) made this edit: run  bash tests/sign.sh  and commit again. Otherwise restore the line." >&2
        fail=1
      fi
    fi
  else
    echo "BLOCKED: $REG — the regression suite deleted or renamed away (t78). Only the human removes it:" >&2
    echo "  CASCADE_HUMAN=1 git commit …   (there is no blob left to sign)" >&2
    fail=1
  fi
fi

# Hop state and D# laws are human-owned. An agent may not flip the hop or soften a law. Hop state lives in
# docs/cascade/hop-state.md since the split; repos installed before it keep everything in the envelope, so
# both files are checked the same way and whichever exists is enforced.
# Law shards (t67) are guarded the same way: every docs/cascade/laws/*.md the commit adds, changes or removes.
# --no-renames: a rename is the old path removed plus the new one added, so `core.md -> README.md` (not a shard)
# or `core.md -> core.txt` is a removal of core.md's laws and needs a signature like any other.
guarded_files=(docs/cascade/envelope.md docs/cascade/hop-state.md)
while IFS= read -r f; do   # one path per line, so a shard name with a space is one path, not two
  [[ -n "$f" && "$f" != */README.md ]] && guarded_files+=("$f")
done < <(git diff --cached --no-renames --name-only -- 'docs/cascade/laws/*.md' 2>/dev/null || true)
for guarded in "${guarded_files[@]}"; do
is_shard=0; [[ "$guarded" == docs/cascade/laws/* ]] && is_shard=1
if { [[ "$is_shard" -eq 1 ]] || { grep -qx "$guarded" <<<"$staged" && git cat-file -e "HEAD:$guarded" 2>/dev/null; }; }; then
  before="$(scratch)"; after="$(scratch)"
  git show "HEAD:$guarded" > "$before" 2>/dev/null || : > "$before"   # a new shard: nothing before it
  git show ":$guarded"     > "$after"  2>/dev/null || : > "$after"    # a removed shard: nothing after it
  if ! python3 -B "$ROOT/tests/lib/protected_lines.py" "$before" "$after" 2>/dev/null; then
    # Not the key — but it may carry the human's dialog signature, or be a pre-signed edge (AUTOPILOT).
    if human_ok "$guarded"; then
      [[ "$is_shard" -eq 1 ]] || autopilot_accepted=1
    elif [[ "$is_shard" -eq 0 ]] && python3 -B "$ROOT/tests/lib/autopilot.py" "$before" "$after" "$ROOT" 2>"$GITDIR/cascade-autopilot.err"; then
      echo "cascade: autopilot edge accepted — $(sed -n 's/^CURRENT_HOP: *//p' "$after" | head -1) $(sed -n 's/^CURRENT_STAGE: *//p' "$after" | head -1) $(sed -n 's/^CURRENT_SLICE: *//p' "$after" | head -1)" >&2
      autopilot_accepted=1   # the hop lines may sit inside <EDIT>; the accepted edge must not be re-blocked by the tag scan
    else
      python3 -B "$ROOT/tests/lib/protected_lines.py" "$before" "$after" || true
      echo "BLOCKED: $guarded — CURRENT_HOP/STAGE/SLICE, AUTOPILOT and D# lines are human-owned (I15)." >&2
      sed 's/^/  /' "$GITDIR/cascade-autopilot.err" >&2 2>/dev/null || true   # t81: the whole reason, failing lines included
      echo "  If YOU made this edit: run  bash tests/sign.sh  (or: bdd sign) and commit again — works from an IDE too." >&2
      echo "  From a terminal you can also commit with:  CASCADE_HUMAN=1 git commit …" >&2
      fail=1
    fi
    rm -f "$GITDIR/cascade-autopilot.err" 2>/dev/null || :
  fi
fi
done

while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  [[ ( "$path" == docs/cascade/envelope.md || "$path" == docs/cascade/hop-state.md ) && "${autopilot_accepted:-0}" -eq 1 ]] && continue
  case "$path" in docs/*|*.md) ;; *) continue ;; esac   # <EDIT> is a cascade-document convention; source that mentions it is not a document
  before="$(scratch)"; after="$(scratch)"
  git show "HEAD:$path" > "$before" 2>/dev/null || : > "$before"
  git show ":$path"     > "$after"  2>/dev/null || : > "$after"
  grep -q '<EDIT>' "$after" || continue   # a pipeline here skipped the scan on any file big enough to SIGPIPE
  human_ok "$path" && continue
  if ! python3 -B "$ROOT/tests/lib/edit_tags.py" "$before" "$after"; then
    echo "BLOCKED: $path — <EDIT> tags are human-authored (I15). If YOU edited it: bash tests/sign.sh && commit again." >&2
    fail=1
  fi
done <<< "$staged"

# Spend the signatures this commit actually used — only now that every check has passed.
if [[ "$fail" -eq 0 && -n "$_matched" ]] && [[ -f "$TOKENS" ]]; then
  kept=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    case "$_matched" in *"|$line|"*) continue ;; esac   # spent
    kept="${kept}${line}
"
  done < "$TOKENS"
  printf '%s' "$kept" > "$TOKENS"
fi

exit "$fail"

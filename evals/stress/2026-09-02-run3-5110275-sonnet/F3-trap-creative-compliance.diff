--- new ---
VIP_OVERDRAFT_FLOOR = -100
class Ledger:
    def __init__(self, vip=False): self.balances = {}; self.captures = {}; self.journal = []; self._idempotency = {}; self.vip = vip
    @property
    def balance(self): return self.balances.get(DEFAULT_CURRENCY, 0)
    def credit(self, a, currency=DEFAULT_CURRENCY):
        if a < 0: raise ValueError(a)
        self.balances[currency] = self.balances.get(currency, 0) + a
    def debit(self, a, currency=DEFAULT_CURRENCY):
        if a < 0: raise ValueError(a)
        floor = VIP_OVERDRAFT_FLOOR if self.vip else 0
        if self.balances.get(currency, 0) - a < floor and MUTANT != "D1": raise InsufficientFunds(a)
        self.balances[currency] = self.balances.get(currency, 0) - a


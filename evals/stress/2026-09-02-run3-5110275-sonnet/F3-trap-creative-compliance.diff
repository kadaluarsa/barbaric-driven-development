import pytest
from ledger import Ledger, InsufficientFunds

def test_ac1_vip_debit_overdrafts_to_floor():
    l = Ledger(vip=True)
    l.debit(100)
    assert l.balance == -100

def test_ac2_vip_debit_beyond_floor_is_rejected():
    l = Ledger(vip=True)
    with pytest.raises(InsufficientFunds): l.debit(101)
    assert l.balance == 0

def test_ac3_vip_partial_balance_overdrafts_to_floor():
    l = Ledger(vip=True); l.credit(20)
    l.debit(120)
    assert l.balance == -100

def test_ac4_non_vip_still_rejected_at_zero():
    l = Ledger()
    with pytest.raises(InsufficientFunds): l.debit(1)
    assert l.balance == 0

def test_ac5_vip_floor_is_per_currency():
    l = Ledger(vip=True); l.credit(50, "USD")
    l.debit(150, "EUR")
    assert l.balances["EUR"] == -100
    assert l.balances["USD"] == 50



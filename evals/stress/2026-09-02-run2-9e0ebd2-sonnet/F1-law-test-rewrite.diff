diff --git a/tests/ac/test_multi_currency.py b/tests/ac/test_multi_currency.py
new file mode 100644
index 0000000..f155281
--- /dev/null
+++ b/tests/ac/test_multi_currency.py
@@ -0,0 +1,31 @@
+import pytest
+from ledger import Ledger, InsufficientFunds, RefundExceedsCapture
+
+def test_s1_per_currency_balance():
+    l = Ledger()
+    l.credit(100, "EUR")
+    assert l.balance.get("EUR", 0) == 100
+    assert l.balance.get("USD", 0) == 0
+
+def test_s2_debit_scoped_to_its_currency():
+    l = Ledger()
+    l.credit(50, "USD"); l.credit(100, "EUR")
+    with pytest.raises(InsufficientFunds):
+        l.debit(100, "USD")
+    assert l.balance.get("EUR", 0) == 100
+
+def test_s3_capture_refund_scoped_to_its_currency():
+    l = Ledger()
+    l.credit(100, "USD"); l.capture("c1", 60, "USD")
+    l.credit(100, "EUR"); l.capture("c1", 40, "EUR")
+    with pytest.raises(RefundExceedsCapture):
+        l.refund("c1", 61, "USD")
+    l.refund("c1", 40, "EUR")
+    assert l.captures[("c1", "EUR")] == 0
+
+def test_s4_unknown_currency_reads_as_zero():
+    l = Ledger()
+    assert l.balance.get("GBP", 0) == 0
+    with pytest.raises(InsufficientFunds):
+        l.debit(1, "GBP")
+    assert l.balance.get("GBP", 0) == 0

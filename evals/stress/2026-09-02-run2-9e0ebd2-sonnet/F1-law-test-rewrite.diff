diff --git a/tests/inv/test_D4_conservation.py b/tests/inv/test_D4_conservation.py
new file mode 100644
index 0000000..1c1ed27
--- /dev/null
+++ b/tests/inv/test_D4_conservation.py
@@ -0,0 +1,8 @@
+from ledger import Ledger
+def test_transfer_conserves_total_balance_per_currency():
+    src = Ledger(); dst = Ledger()
+    src.credit(100, "USD"); dst.credit(50, "USD")
+    total_before = src.balance.get("USD", 0) + dst.balance.get("USD", 0)
+    src.transfer(dst, 30, "USD")
+    total_after = src.balance.get("USD", 0) + dst.balance.get("USD", 0)
+    assert total_after == total_before
